# Copy to .env.local and fill in.

# ---- PayPal (Sandbox) ----
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# developer.paypal.com -> Testing Tools -> Sandbox Accounts -> the Business account email
PAYPAL_SANDBOX_BUSINESS_EMAIL=

# ---- AI ----
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# ---- Optional ----
# Sandbox *personal* account emails used by the one-click demo group (so you can log in and pay)
DEMO_EMAIL_1=
DEMO_EMAIL_2=
DEMO_EMAIL_3=
# Guardrail: max cents per single PayPal request (default 100000 = $1,000)
MAX_REQUEST_CENTS=100000
# Where the JSON data file is stored (default ./data)
DATA_DIR=
