# Copy to .env.local and fill in.

# ---- PayPal (Sandbox) ----
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# developer.paypal.com -> Testing Tools -> Sandbox Accounts -> the Business account email
PAYPAL_SANDBOX_BUSINESS_EMAIL=
# developer.paypal.com -> your app -> Webhooks -> Add webhook (URL: https://<your-app>/api/paypal/webhook) -> copy the Webhook ID
PAYPAL_WEBHOOK_ID=

# ---- AI ----
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# ---- Optional ----
# Sandbox *personal* account emails used by the one-click demo group (so you can log in and pay)
DEMO_EMAIL_1=
DEMO_EMAIL_2=
DEMO_EMAIL_3=
# Guardrail: max cents per single PayPal request (default 100000 = $1,000)
MAX_REQUEST_CENTS=100000
# Where the JSON data file is stored (default ./data)
DATA_DIR=
# Autopilot: built-in scheduler (set to "off" to use an external cron hitting /api/autopilot/tick instead)
AUTOPILOT_SCHEDULER=
# Protects /api/autopilot/tick when set
CRON_SECRET=
# Max AI calls per visitor per 10 minutes on the public demo (default 40)
AI_RATE_LIMIT=
# Public base URL used in invoice links (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=
